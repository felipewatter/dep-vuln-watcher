{
  "name": "dep-vuln-watcher",
  "version": "1.1.1",
  "description": "npm dependency vulnerability audit, outdated reporting and snapshot comparisons",
  "license": "MIT",
  "author": "Felipe Watter",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "dep-vuln-watcher": "./dist/bin/index.js"
  },
  "main": "./dist/src/checker.js",
  "types": "./dist/src/checker.d.ts",
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "start": "node dist/bin/index.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "~7.0.2"
  }
}
